generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  Admin
  Educator
  Student
}

model User {
  user_id             Int       @id @default(autoincrement())
  username            String    @unique
  password            String
  role                Role
  first_name          String?
  last_name           String?
  email               String    @unique
  contact_number      String?
  profile_picture_url String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt
  receivedMessages    Message[] @relation("ReceivedMessages")
  sentMessages        Message[] @relation("SentMessages")
  coursesEnrolled   Course[]     @relation("UserCourses")
  coursesOwned      Course[]     @relation("CourseOwners")
  topicsCreated       Topic[]   @relation("UserTopics")
}

model Message {
  message_id   Int       @id @default(autoincrement())
  sender_id    Int
  receiver_id  Int
  message_text String
  sent_at      DateTime  @default(now())
  read_at      DateTime?
  receiver     User      @relation("ReceivedMessages", fields: [receiver_id], references: [user_id])
  sender       User      @relation("SentMessages", fields: [sender_id], references: [user_id])
}


model Course {
  course_id         Int      @id @default(autoincrement())
  course_code       String   @unique
  title             String
  description       String
  prerequisites     String?
  learning_outcomes String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt
  owners            User[]   @relation("CourseOwners")
  users             User[]   @relation("UserCourses")
  course_picture_url String? // Add this line to your model
  topics            Topic[]  // Relation to topics

}


model Topic {
  topic_id         Int      @id @default(autoincrement())
  title            String
  content          String?
  course_id        Int
  course           Course   @relation(fields: [course_id], references: [course_id])
  creator_id       Int?     // Optional: user who created the topic (can be an educator)
  creator          User?    @relation("UserTopics", fields: [creator_id], references: [user_id]) // Relation to User (creator)
}